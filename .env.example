# Desarrollo local (dotnet run / dotnet ef): la API lee estas variables desde este archivo.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=dulceatardecer;Username=dulceatardecer;Password=TU_PASSWORD
ApiSettings__SecretKey=GENERA_UNA_CLAVE_DE_AL_MENOS_32_BYTES
InitialAdmin__Username=admin
InitialAdmin__Password=CAMBIA_ESTA_CONTRASENA

# Docker Compose (VPS): la API se une a la red del contenedor de PostgreSQL y arma su cadena de conexión con estos datos.
DB_HOST=dulceatardecer-postgres
DB_NETWORK=dulceatardecer_db
DB_NAME=dulceatardecer
POSTGRES_USER=dulceatardecer
POSTGRES_PASSWORD=TU_PASSWORD
CORS_ALLOWED_ORIGIN=https://tu-frontend.com
# API_PORT=8080
